    "execute": [
      {
        "description": "create table \"panitia_accounts\"",
        "sql": "CREATE TABLE \"public\".\"panitia_accounts\" (\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" uuid DEFAULT (gen_random_uuid()) NOT NULL,\n  \"is_active\" bool DEFAULT true NOT NULL,\n  \"nama\" character varying(100) NOT NULL,\n  \"password_hash\" text NOT NULL,\n  \"role\" character varying(20) DEFAULT 'SCANNER' NOT NULL,\n  \"username\" character varying(50) NOT NULL,\n  CONSTRAINT \"panitia_accounts_pkey\" PRIMARY KEY (\"id\"),\n  CONSTRAINT \"panitia_accounts_role_check\" CHECK (((role)::text = ANY ((ARRAY['ADMIN'::character varying, 'SCANNER'::character varying])::text[])))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"panitia_accounts\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
