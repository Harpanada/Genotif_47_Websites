// use prisma-8
model DataLomba {
  id         String   @id
  jenisLomba String
  statusBayar String  @default("PENDING")
  orderId    String   @unique @default(uuid())
  createdAt DateTime @default(now())

// Ticketing
  ticketToken String?   @unique
  checkedInAt DateTime?

  funRun         DetailFunRun?
  stms           DetailSTMS?
  cerdasCermat   DetailCerdasCermat?
  mewarnai       DetailMewarnai?

 
}

model DetailFunRun {
  id            String   @id
  namaLengkap   String
  jenisKelamin  String
  kontakDarurat String
  email         String
  noWhatsapp    String

  dataLombaId String    @unique
  dataLomba   DataLomba @relation(fields: [dataLombaId], references: [id], onDelete: Cascade)
}

model DetailSTMS {
  id                 String   @id
  namaPerwakilan     String
  kelas              String
  jenisBakat         String
  jumlahAnggota      Int
  perlengkapan       String?
  noWhatsapp         String
  email              String
  menggunakanMusik   Boolean  @default(false)

  dataLombaId String    @unique
  dataLomba   DataLomba @relation(fields: [dataLombaId], references: [id], onDelete: Cascade)
  anggota     AnggotaSTMS[]
}

model AnggotaSTMS {
  id           String     @id
  namaLengkap  String
  detailSTMSId String
  detailSTMS   DetailSTMS @relation(fields: [detailSTMSId], references: [id], onDelete: Cascade)
}

model DetailCerdasCermat {
  id                String   @id
  namaSekolah       String
  alamatSekolah     String
  namaGuruPendamping String
  emailPendamping   String
  whatsappPendamping String

  dataLombaId String    @unique
  dataLomba   DataLomba @relation(fields: [dataLombaId], references: [id], onDelete: Cascade)
  anggota     AnggotaCerdasCermat[]
}

model AnggotaCerdasCermat {
  id                   String             @id
  namaLengkap          String
  kelas                String
  detailCerdasCermatId String
  detailCerdasCermat   DetailCerdasCermat @relation(fields: [detailCerdasCermatId], references: [id], onDelete: Cascade)
}

model DetailMewarnai {
  id             String   @id
  namaPeserta    String
  asalSekolah    String
  kelas          Int
  usia           Int
  namaOrangTua   String
  whatsappOrangTua String
  emailOrangTua  String
  paketLomba     String

  dataLombaId String    @unique
  dataLomba   DataLomba @relation(fields: [dataLombaId], references: [id], onDelete: Cascade)
}
