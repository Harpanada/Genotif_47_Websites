// use prisma-8

model Peserta {
  id          String    @id @default(uuid())
  namaLengkap String
  email       String
  noWhatsapp  String
  lomba       DataLomba?
}

model DataLomba {
  id          String   @id @default(uuid())
  jenisLomba  String
  statusBayar String   @default("PENDING")
  orderId     String   @unique @default(uuid())
  paymentUrl  String?

  pesertaId   String   @unique
  peserta     Peserta  @relation(fields: [pesertaId], references: [id])

  detailFunRun       DetailFunRun?
  detailSTMS         DetailSTMS?
  detailCerdasCermat DetailCerdasCermat?
  detailMewarnai     DetailMewarnai?
}

model DetailFunRun {
  id                 String    @id @default(uuid())
  jenisKelamin       String
  kontakDarurat      String
  dataLombaId        String    @unique
  dataLomba          DataLomba @relation(fields: [dataLombaId], references: [id])
}

model DetailSTMS {
  id               String    @id @default(uuid())
  kelas            String
  jenisBakat       String
  jumlahAnggota    Int
  perlengkapan     String?
  menggunakanMusik Boolean   @default(false)
  dataLombaId      String    @unique
  dataLomba        DataLomba @relation(fields: [dataLombaId], references: [id])
  anggota          AnggotaSTMS[]
}

model AnggotaSTMS {
  id           String     @id @default(uuid())
  namaLengkap  String
  detailSTMSId String
  detailSTMS   DetailSTMS @relation(fields: [detailSTMSId], references: [id])
}

model DetailCerdasCermat {
  id                 String    @id @default(uuid())
  namaSekolah        String
  alamatSekolah      String
  namaGuruPendamping String
  emailPendamping    String
  whatsappPendamping String
  dataLombaId        String    @unique
  dataLomba          DataLomba @relation(fields: [dataLombaId], references: [id])
  anggota            AnggotaCerdasCermat[]
}

model AnggotaCerdasCermat {
  id                   String              @id @default(uuid())
  namaLengkap          String
  kelas                String
  jabatan              String
  detailCerdasCermatId String
  detailCerdasCermat   DetailCerdasCermat  @relation(fields: [detailCerdasCermatId], references: [id])
}

model DetailMewarnai {
  id               String    @id @default(uuid())
  asalSekolah      String
  kelas            String
  tanggalLahir     DateTime?
  usia             Int?
  paketLomba       String
  namaOrangTua     String
  emailOrangTua    String
  whatsappOrangTua String
  dataLombaId      String    @unique
  dataLomba        DataLomba @relation(fields: [dataLombaId], references: [id])
}
